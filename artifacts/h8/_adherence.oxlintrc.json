        "selector": "JSXOpeningElement[name.name='Inline'] > JSXAttribute > JSXIdentifier[name!=/^(?:gap|inset|align|justify|wrap|ref|id|children|key|ref|className|style|children)$/]",
        "message": "<Inline> doesn't accept that prop. Declared props: gap, inset, align, justify, wrap, ref, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Inline'] > JSXAttribute[name.name='gap'] > Literal[value!=/^(?:none|sm|md)$/]",
        "message": "<Inline> gap must be one of 'none' | 'sm' | 'md'."
