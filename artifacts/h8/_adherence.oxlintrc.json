        "message": "<Container> doesn't accept that prop. Declared props: width, gutter, ref, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:content|wide|full)$/]",
        "message": "<Container> width must be one of 'content' | 'wide' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|columns|onRowSelect|empty|key|ref|className|style|children)$/]",
        "message": "<DataGrid> doesn't accept that prop. Declared props: data, columns, onRowSelect, empty."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|modal|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: children, open, defaultOpen, modal."
      },
