      {
        "selector": "JSXOpeningElement[name.name='Inline'] > JSXAttribute[name.name='inset'] > Literal[value!=/^(?:none|xs|sm|md|lg)$/]",
        "message": "<Inline> inset must be one of 'none' | 'xs' | 'sm' | 'md' | 'lg'."
