        "message": "<Sidebar> collapsible must be one of 'none' | 'icon' | 'offcanvas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spacer'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|ref|id|key|ref|className|style|children)$/]",
        "message": "<Spacer> doesn't accept that prop. Declared props: size, ref, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spacer'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Spacer> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute > JSXIdentifier[name!=/^(?:gap|inset|align|ref|id|children|key|ref|className|style|children)$/]",
        "message": "<Stack> doesn't accept that prop. Declared props: gap, inset, align, ref, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute[name.name='gap'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Stack> gap must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stack'] > JSXAttribute[name.name='inset'] > Literal[value!=/^(?:none|xs|sm|md|lg)$/]",
