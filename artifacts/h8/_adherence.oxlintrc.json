      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|neutral)$/]",
        "message": "<StatusPill> tone must be one of 'success' | 'warning' | 'danger' | 'neutral'."
