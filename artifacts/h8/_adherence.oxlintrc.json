{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/action/Button/**",
              "components/communication/Badge/**",
              "components/communication/Empty/**",
              "components/communication/Skeleton/**",
              "components/datadisplay/DataGrid/**",
              "components/datadisplay/StatusPill/**",
              "components/datadisplay/Table/**",
              "components/display/Label/**",
              "components/display/Separator/**",
              "components/layout/Box/**",
              "components/layout/Card/**",
              "components/layout/Container/**",
              "components/layout/Grid/**",
              "components/layout/Inline/**",
              "components/layout/Section/**",
              "components/layout/Spacer/**",
              "components/layout/Stack/**",
              "components/navigation/Pagination/**",
              "components/navigation/Sidebar/**",
              "components/overlay/Dialog/**",
              "components/overlay/DropdownMenu/**",
              "components/overlay/Popover/**",
              "components/overlay/Sheet/**",
              "components/overlay/Tooltip/**",
              "components/patterns/EmptyState/**",
              "components/patterns/ListDetail/**",
              "components/selection/Checkbox/**",
              "components/selection/Select/**",
              "components/templates/AppShell/**",
              "components/textinput/Input/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|nav|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: brand, nav, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|asChild|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|outline|secondary|ghost|destructive)$/]",
        "message": "<Badge> variant must be one of 'link' | 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute > JSXIdentifier[name!=/^(?:inset|ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Box> doesn't accept that prop. Declared props: inset, ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute[name.name='inset'] > Literal[value!=/^(?:none|xs|sm|md|lg)$/]",
        "message": "<Box> inset must be one of 'none' | 'xs' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|size|asChild|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, size, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:link|default|outline|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'link' | 'default' | 'outline' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|xs|sm|lg|icon|icon-xs|icon-sm|icon-lg)$/]",
        "message": "<Button> size must be one of 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|size|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ref, className, id, style, children, size."
