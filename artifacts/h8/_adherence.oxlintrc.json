        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|gap|inset|ref|id|children|key|ref|className|style|children)$/]",
        "message": "<Grid> doesn't accept that prop. Declared props: columns, gap, inset, ref, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grid'] > JSXAttribute[name.name='gap'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Grid> gap must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Grid'] > JSXAttribute[name.name='inset'] > Literal[value!=/^(?:none|xs|sm|md|lg)$/]",
        "message": "<Grid> inset must be one of 'none' | 'xs' | 'sm' | 'md' | 'lg'."
      },
