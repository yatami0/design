      },
      {
        "selector": "JSXOpeningElement[name.name='ListDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|list|title|detail|key|ref|className|style|children)$/]",
        "message": "<ListDetail> doesn't accept that prop. Declared props: state, list, title, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|modal|key|ref|className|style|children)$/]",
        "message": "<Popover> doesn't accept that prop. Declared props: children, open, defaultOpen, modal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|gap|ref|id|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: heading, gap, ref, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='gap'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Section> gap must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|dir|name|autoComplete|disabled|required|form|value|defaultValue|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: children, open, defaultOpen, dir, name, autoComplete, disabled, required, form, value, defaultValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<Select> dir must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|decorative|style|className|id|children|asChild|ref|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: orientation, decorative, style, className, id, children, asChild, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Separator> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|modal|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: children, open, defaultOpen, modal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|side|variant|collapsible|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: ref, className, id, style, children, side, variant, collapsible."
      },
      {
