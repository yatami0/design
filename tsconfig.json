{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // --- PoC の @repo/typescript-config/base.json 相当（逐語） ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "target": "ES2023",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // --- PoC の @repo/typescript-config/nextjs.json 相当（逐語） ---
    // types: ["node"] は TS 6.0 で必須（既定が [] になり @types/node の自動 include が廃止）
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // --- 本 repo 固有（PoC には無い）---
    // shadcn/ui が既定で要求するエイリアス（components.json の aliases）。
    // ⚠ PoC の apps/redmine には paths エイリアスが無い＝移送時の差分になる。
    //    PoC 側に足すか相対パスへ書き換えるかは手9（移送手順）で決める。
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    ".next/types/**/*.ts",
    "*.config.ts",
    ".next/dev/types/**/*.ts",
    // 手2b D14: これが無いと .storybook/** は typecheck の対象外になり、
    // lint も projectService が型情報を取れず Parsing error で落ちる（検査されずにエラーだけ出る）。
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
