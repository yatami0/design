{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // --- PoC の @repo/typescript-config/base.json 相当（逐語） ---
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // 🟥 借金（手3 D5=A・暫定。DR-0014）
    //   PoC の packages/typescript-config/base.json は true。ここだけ false にしている。
    //   理由: shadcn の dropdown-menu.tsx:94 が true と非互換で、`pnpm build` が赤のままだと
    //         手4（画面を組む）で詰まる。**解決ではなく時間稼ぎ。**
    //   返上の道: D1=(c) で製品層のラッパーを持てるので、そこで型を吸収すれば true に戻せる。
    //   🟥 このまま移送すると手9 で赤が復活する。手9 の移送手順に必ず載せること。
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "target": "ES2023",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // --- PoC の @repo/typescript-config/nextjs.json 相当（逐語） ---
    // types: ["node"] は TS 6.0 で必須（既定が [] になり @types/node の自動 include が廃止）
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // --- 本 repo 固有（PoC には無い）---
    // shadcn/ui が既定で要求するエイリアス（components.json の aliases）。
    // ⚠ PoC の apps/redmine には paths エイリアスが無い＝移送時の差分になる。
    //    PoC 側に足すか相対パスへ書き換えるかは手9（移送手順）で決める。
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    ".next/types/**/*.ts",
    "*.config.ts",
    ".next/dev/types/**/*.ts",
    // 手2b D14: これが無いと .storybook/** は typecheck の対象外になり、
    // lint も projectService が型情報を取れず Parsing error で落ちる（検査されずにエラーだけ出る）。
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
